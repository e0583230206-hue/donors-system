# Node
frontend/backend/node_modules/
npm-debug.log
*.log

# Environment (אסור להעלות לגיט — מכיל סודות!)
.env
*.env
!.env.example

# Ad-hoc .env backup snapshots (created before env changes, e.g. .env.bak-before-*)
# — same secrets risk as .env itself, but the *.env pattern above doesn't
# match "*.env.bak-*" (suffix, not extension). Live copies belong in
# /root/secrets-archive/donors-system/, never in the repo tree.
.env.bak*
*.env.bak*

# Database (מכיל נתוני משתמשים)
*.sqlite
*.db

# Server-generated backups (גיבויים אוטומטיים + גיבויי migration — מכילים נתוני משתמשים)
frontend/backend/backups/

# Ad-hoc exports for review/sharing (מכיל בעבר סודות + node_modules + גיבויים —
# ראו ממצא #2/#31/#32 בדוח האבטחה) — לעולם לא לשלוח ZIP מהתיקייה החיה
*.zip

# Logs
logs/
*.log
server_err.txt
server_out.txt

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Claude Code local session/permission state (מכיל נתיבים מקומיים ספציפיים למכונה)
.claude/
